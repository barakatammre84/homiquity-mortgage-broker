# Copy this file to .env and fill in the values. .env is gitignored — never commit it.
# The dev server loads .env automatically (via dotenv in server/index-dev.ts).

# --- Database (required) -----------------------------------------------------
# Fully local (offline, free): run Postgres locally and use a localhost URL —
# the app auto-uses the standard pg driver for localhost/127.0.0.1.
#   docker run -d -e POSTGRES_PASSWORD=pass -e POSTGRES_DB=homiquity -p 5432:5432 postgres:16
#   DATABASE_URL=postgresql://postgres:pass@localhost:5432/homiquity
# Or hosted free: create a database at https://neon.tech and paste its URL.
DATABASE_URL=
# Force the local pg driver even for a non-localhost URL (rarely needed):
# USE_LOCAL_PG=true

# --- Security secrets --------------------------------------------------------
# Required in PRODUCTION — `pnpm start` throws at boot without all three
# (SESSION_SECRET must also be >= 32 chars). Locally the picture is different,
# and the difference has cost people an afternoon:
#   SESSION_SECRET       MANDATORY even in dev, and it fails SILENTLY. Its boot
#                        guard is production-only (server/integrations/auth/session.ts),
#                        so the dev server starts fine and then every login 500s
#                        with `secret option required for sessions`.
#   CREDIT_ENCRYPTION_KEY / PII_HASH_SALT
#                        Optional in dev — both fall back silently outside
#                        production (server/services/encryptionService.ts).
# Set all three anyway; it is three commands and it matches how prod behaves.
# Generate each with the command shown, then paste the output.
# CREDIT_ENCRYPTION_KEY : openssl rand -base64 32
CREDIT_ENCRYPTION_KEY=
# PII_HASH_SALT         : openssl rand -hex 32
PII_HASH_SALT=
# SESSION_SECRET        : openssl rand -hex 32
SESSION_SECRET=

# --- Key rotation & Cloud KMS envelope encryption (optional) -----------------
# PII (SSNs, account numbers, Plaid tokens) is encrypted with a key selected by
# `keyId`. CREDIT_ENCRYPTION_KEY above is "v1". You can rotate two ways:
#
# A) App-level rotation (no KMS): add a second 256-bit key and make it active.
# CREDIT_ENCRYPTION_KEY_V2=          # openssl rand -base64 32
# ENCRYPTION_ACTIVE_KEY_ID=v2        # new writes use v2; v1 rows still decrypt
#
# B) Cloud KMS envelope encryption (recommended for production): the actual data
#    keys (DEKs) are wrapped by a KMS key (KEK) that never leaves KMS. Generate a
#    wrapped DEK with `npx tsx scripts/kms-wrap-dek.ts kms-1` and paste it below.
#    Requires `npm i @google-cloud/kms` in the deploy env + GCP credentials.
#    (The dep is optional and not in package.json.) See knowledge-base/handbook/app-guide/06.
# PII_KMS_KEY_NAME=projects/P/locations/L/keyRings/R/cryptoKeys/K
# PII_KMS_WRAPPED_DEKS=[{"keyId":"kms-1","wrappedDek":"<base64>"}]

# --- AI (optional — document extraction + AI Coach both use Anthropic Claude) --
# Get a key at https://platform.claude.com/ (or set EXTRACTION_SIMULATE=true
# for deterministic simulated extraction with no key — the clean local/demo choice).
ANTHROPIC_API_KEY=
# EXTRACTION_SIMULATE=true

# --- Local dev conveniences --------------------------------------------------
NODE_ENV=development
# 5001 on macOS — AirPlay Receiver squats on port 5000.
PORT=5001
# Enables the /api/test-login dev accounts (non-production only). Pick any password.
DEV_TEST_PASSWORD=
# Canonical production base URL for customer-facing links (SMS/email document
# links, health checks). Defaults to the live custom domain
# (https://www.homiquity.com). Override per environment if needed.
# APP_BASE_URL=https://www.homiquity.com

# --- Credit vendor: TWO variables, and they mean different things --------------
# Confusing them falsifies a regulated record, so read both before touching either.
#
# CREDIT_VENDOR_API_KEY = PROVENANCE, not a connection setting. Its value is
#   never used to call anything (there is no live bureau adapter yet). While it
#   is UNSET, every credit_pulls row and cost-ledger entry is stamped
#   isSimulated/simulated = true. Setting it flips that stamp to false.
#   ⛔ Do not set it until a real bureau adapter is wired (roadmap F3) — a set
#   key with no adapter makes each row assert a bureau inquiry that never
#   happened.
# CREDIT_VENDOR_API_KEY=
#
# CREDIT_VENDOR_MODE = PERMISSION. "simulation" lets the fabricating path
#   (simulateCreditPullCompletion, which invents scores with Math.random) run
#   under NODE_ENV=production. Without it, production refuses the pull outright.
# CREDIT_VENDOR_MODE=simulation
#
# CURRENT PRODUCTION STATE (2026-08-06): CREDIT_VENDOR_MODE=simulation IS set on
# the Railway service, deliberately, so the pull flow can be exercised while the
# F3 bureau contract is finalized. Rows are still stamped isSimulated: true, and
# the FCRA §615(a) guard still refuses to name a bureau on an adverse-action
# notice sourced from a simulated pull.
#
# 🚨 AT THE F3 HANDOFF: set CREDIT_VENDOR_API_KEY and REMOVE CREDIT_VENDOR_MODE
# in the SAME change. Both on at once = invented scores recorded as a genuine
# consumer report. server/services/creditPulls.ts refuses that combination
# outright (tests/creditVendorInterlock.test.ts), so you will get a loud error
# rather than a falsified record — but the removal is still yours to do.

# --- Private beta gate (server/middleware/betaGate.ts) ------------------------
# When set, the whole site (except /api/*) locks behind invite links:
# https://<host>/?beta=<code>. Comma-separate multiple codes to hand different
# groups different codes and revoke them individually. Unset = gate off
# (public), which is why it is safe to leave blank locally. Set it in the
# Railway service variables to arm it. See CICD.md "Private beta gate".
# BETA_ACCESS_CODE=

# --- Content Security Policy ---------------------------------------------------
# CSP ships in Report-Only mode by default (violations logged via /api/csp-report,
# nothing blocked). After a clean soak, set CSP_ENFORCE=true to switch browsers
# to blocking mode. Dev is always exempt (Vite HMR needs inline scripts).
# CSP_ENFORCE=true

# --- Pre-license launch gate (armed launch — roadmap F1 / LS-1) ---------------
# Homiquity cannot solicit a mortgage transaction until the company NMLS license
# is issued. Until then the public site runs "gated": educational + legal pages
# and a waitlist only — no rates, pricing, application funnel, or persona LPs.
#
# Server (this env): unset = FAIL-SAFE — gated automatically in production while
# the company NMLS id is PENDING in shared/companyIdentity.ts. Set explicitly to
# open on F1 day.
# PRELAUNCH_GATED=false
#
# Client (BUILD-time — a VITE_* var is baked into the bundle, so it must be set
# in Railway BEFORE the build; changing it requires a redeploy, not a restart):
# a production build is gated unless explicitly opened.
# Flip BOTH (plus the real NMLS id) together on F1 day. See
# knowledge-base/governance/ARMED_LAUNCH_CHARTER_2026-07-07.md.
# VITE_PRELAUNCH_GATED=false

# --- Scheduled jobs -----------------------------------------------------------
# Authenticates the daily cron calls to /api/jobs/* (equity snapshots, PMI/refi
# alerts, letter expiry, adverse-action delivery, task escalation, aggregation).
# Generate with: openssl rand -hex 24
# The SAME value must be set in BOTH places or every sweep 401s:
#   1. the Railway service variables (what the app checks), and
#   2. the CRON_SECRET *repository secret* in GitHub Actions settings (what
#      .github/workflows/cron-jobs.yml sends).
# Without it the sweeps only run manually (admin).
CRON_SECRET=

# --- Object storage (documents / uploads) ------------------------------------
# In production and locally, storage uses Google Cloud Storage with a
# standard service account:
#   1. Create a GCS bucket + a service account with "Storage Object Admin" on it.
#   2. Download the service-account JSON key and paste the WHOLE JSON here
#      (single line) — or set GOOGLE_APPLICATION_CREDENTIALS to the file path.
# GCS_SERVICE_ACCOUNT_KEY=
# Bucket paths (format: /<bucket-name>/<prefix>):
# PRIVATE_OBJECT_DIR=/my-bucket/private
# PUBLIC_OBJECT_SEARCH_PATHS=/my-bucket/public

# --- AI Coach (Anthropic) ------------------------------------------------------
# Powers the borrower AI Coach (server/services/coachingService.ts — Claude
# Sonnet 5 with streaming + tool-use). Without it the coach runs in a clearly
# labeled offline-guidance mode; no other feature is affected. Create a key at
# https://console.anthropic.com and set it here AND in the Railway service env.
# ANTHROPIC_API_KEY=

# --- Alternate AI credentials (optional) -------------------------------------
# Read first by document extraction where set; falls back to ANTHROPIC_API_KEY.
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=

# --- Webhooks (REQUIRED in production if the Plaid assets webhook is used) ----
# Shared secret checked on POST /api/webhooks/plaid-assets. In production the
# endpoint returns 503 until this is set (fail-closed). Generate:
# openssl rand -hex 24 — and configure the same value on the webhook sender.
# PLAID_WEBHOOK_SECRET=

# --- Twilio / SMS webhooks (REQUIRED in production once SMS is live) ---------
# Twilio is a DIFFERENT product from SendGrid below, with different credentials.
# SendGrid keys look like "SG.<id>.<secret>"; every Twilio SID is a 2-letter
# prefix + 32 hex = 34 chars. A 22-character base64 value came from the wrong
# console.
#
# Account identity + outbound credentials. Prefer an API key (Console → Account
# → API keys & tokens → Create API key, type Standard) over the Auth Token for
# outbound calls: rotating the Auth Token invalidates ALL API keys and is not
# reversible. The API key secret is displayed once, at creation.
# TWILIO_ACCOUNT_SID=            # AC + 32 hex
# TWILIO_API_KEY_SID=            # SK + 32 hex
# TWILIO_API_KEY_SECRET=
# TWILIO_PHONE_NUMBER=           # E.164, e.g. +13125551234 — the sending number
#
# No outbound sender reads these yet — they are documented here because the
# webhooks below are only half of the integration, and because the account these
# identify is the same one whose Auth Token signs them. Outbound sending must
# additionally pass evaluateOutboundSms() in server/services/smsCompliance.ts
# (opt-out ledger + TCPA quiet hours), and US A2P traffic requires 10DLC brand
# and campaign registration, which Twilio does not permit on trial accounts.
#
# Signing key for POST /api/webhooks/sms. Twilio signs every inbound webhook
# with the account's PRIMARY AUTH TOKEN — an API key secret is NOT
# interchangeable with it, so this is its own variable even if the app later
# authenticates outbound sends with an API key SID/secret pair. Copy it from
# Console → Account → API keys & tokens ("Auth Token").
#
# Fail-closed, same posture as PLAID_WEBHOOK_SECRET: with this unset the webhook
# returns 503 in production. Outside production an unset token leaves the
# provider-agnostic JSON path open for local testing; a token that IS set is
# enforced in every environment.
# TWILIO_AUTH_TOKEN=
#
# Optional. The exact URL configured on the Twilio number, used to verify the
# signature when a proxy rewrites scheme or host and the reconstructed URL would
# not match. Set it if signature checks fail in an environment where the app
# does not see the client-facing scheme/host.
# TWILIO_WEBHOOK_URL=https://www.homiquity.com/api/webhooks/sms
#
# The TWO webhook fields on a Twilio number are different endpoints. Configure:
#   "A MESSAGE COMES IN"    -> https://www.homiquity.com/api/webhooks/sms
#   "STATUS CALLBACK URL"   -> https://www.homiquity.com/api/webhooks/sms/status
# The first receives texts people send US (STOP/START/HELP). The second receives
# delivery receipts for messages WE send, and converges the opt-out ledger when
# Twilio reports error 21610 (recipient already unsubscribed). Both authenticate
# with TWILIO_AUTH_TOKEN above.
#
# Optional, and the pin for the STATUS endpoint specifically. The signature
# covers the URL Twilio was configured with, so the status callback must NOT
# reuse TWILIO_WEBHOOK_URL — that pins the inbound path and would reject every
# receipt. Leave unset to derive the URL from the request.
# TWILIO_STATUS_CALLBACK_URL=https://www.homiquity.com/api/webhooks/sms/status

# --- Vendor integrations (optional — simulated until contracts are signed) ----
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# CRS_API_KEY=
# ISOFTPULL_API_KEY=
# FANNIE_DU_API_KEY=
# HOUSECANARY_API_KEY=
# RAPIDAPI_KEY=
# Use separate restricted keys in production. The server key calls Places API
# (New), Geocoding API, and Address Validation API and should be restricted to
# the production server's egress IP. The browser key is intentionally returned
# to the client for Maps JavaScript/Street View and must be HTTP-referrer
# restricted to Homiquity's production and local origins.
# GOOGLE_MAPS_SERVER_API_KEY=
# GOOGLE_MAPS_BROWSER_API_KEY=
# Local development compatibility only; ignored when NODE_ENV=production.
# GOOGLE_MAPS_API_KEY=

# --- Email (optional in dev; REQUIRED in production) --------------------------
# Unset, emailService has no provider. In dev that's fine — messages are printed
# to the console and sendEmail() reports success. In production nothing is sent
# and nothing retries: password resets, email verification, waitlist invites and
# application notifications are discarded. Set at least SENDGRID_API_KEY on any
# host serving real users. Confirm from outside with:
#   curl -s https://<host>/api/health | jq .email   →  {"configured":true,...}
# SENDGRID_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# FROM_EMAIL=
# FROM_NAME=

# --- Social login (optional) --------------------------------------------------
# Each provider's "Sign in with …" button appears ONLY when BOTH its client id
# and secret are set (see /api/auth/providers). The OAuth flow is server-side:
# the provider redirects back to  <host>/api/auth/<provider>/callback , so add
# that exact callback URL to the provider console for EVERY host you serve —
# e.g. https://www.homiquity.com/api/auth/google/callback and, for local testing,
# http://localhost:5001/api/auth/google/callback . Set the secrets in the Railway
# service variables, never commit real values.
#
# Google  (console: https://console.cloud.google.com/apis/credentials)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# LinkedIn
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
#
# Apple — the "client secret" is a short-lived ES256 JWT generated from these.
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# --- Error monitoring (optional) ----------------------------------------------
# Set SENTRY_DSN to enable error reporting (dependency-free HTTP reporter).
# Point a free uptime monitor (e.g. UptimeRobot) at GET /api/health.
# SENTRY_DSN=

# --- AI risk brief (staff advisory narration; roadmap A4) ---------------------
# Uses ANTHROPIC_API_KEY. Without a key it serves a labeled deterministic
# template. Set RISK_BRIEF_DISABLED=true to kill the model call per-request.
# RISK_BRIEF_DISABLED=

# --- Misc tuning (optional, sensible defaults in code) ------------------------
# PUBLIC_BASE_URL=          # absolute URL used in emails/links
# AUS_TIMEOUT_MS=
# MCP_VENDOR_TIMEOUT_MS=
# LOOKUP_MATRIX_STAMP_WINDOW_MS=
# PRICING_MARGIN_BASE_BPS=
