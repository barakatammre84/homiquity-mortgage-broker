{
  "name": "homiquity",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index-dev.ts",
    "build": "vite build && esbuild server/index-prod.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "test": "node scripts/test-collection-guard.cjs",
    "harness:t0": "bash scripts/harness.sh t0",
    "harness:t1": "bash scripts/harness.sh t1",
    "harness:t2": "bash scripts/harness.sh t2",
    "harness:t3": "bash scripts/harness.sh t3",
    "test:raw": "vitest run --config vitest.config.ts && vitest run --config vitest.client.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "mcp": "tsx server/mcp/index.ts",
    "checkup": "bash scripts/checkup.sh",
    "reg:watch": "node scripts/regulatory-watch.cjs",
    "sg:watch": "node scripts/selling-guide-watch.cjs",
    "sg:watch:save": "node scripts/selling-guide-watch.cjs --update-state",
    "reg:watch:save": "node scripts/regulatory-watch.cjs --update-state",
    "reg:triage": "node scripts/regulatory-triage.cjs",
    "db:generate": "echo 'BLOCKED: drizzle-kit generate has snapshot drift in this repo and emits wrong SQL. Hand-author migrations/NNNN_*.sql + a migrations/meta/_journal.json entry instead — see CLAUDE.md, Database.' && exit 1",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:adopt": "tsx server/scripts/markMigrationsApplied.ts",
    "db:migrate:prod": "node scripts/migrate-prod.cjs",
    "db:push": "echo 'BLOCKED: db:push drops columns owned by other branches on the shared dev DB, and prod is migrate-only. Hand-author SQL in migrations/ and run pnpm db:migrate — see CLAUDE.md, Database.' && exit 1",
    "data:hmda": "tsx server/scripts/ingestHmdaCompetitors.ts",
    "data:fannie": "tsx server/scripts/ingestFannieMaePerformance.ts",
    "guard:schema": "node scripts/schema-migration-guard.cjs",
    "guard:tokens": "node scripts/design-token-guard.cjs",
    "guard:ui": "node scripts/ui-standard-guard.cjs",
    "guard:channel": "node scripts/delivery-stack-freeze-guard.cjs",
    "guard:docs": "node scripts/doc-freshness-guard.cjs",
    "guard:querykeys": "node scripts/query-key-guard.cjs && node scripts/query-key-reachability.cjs && node scripts/query-key-transport-guard.cjs",
    "guard:migrations": "node scripts/migration-ledger-guard.cjs",
    "guard:security": "node scripts/security-review-guard.cjs",
    "guard:authority": "node scripts/selling-guide-authority-guard.cjs",
    "coverage:sg": "node scripts/selling-guide-coverage.cjs",
    "guard:coverage": "node scripts/selling-guide-coverage.cjs --check",
    "guard:corpus": "node scripts/selling-guide-corpus-guard.cjs",
    "guard:conformance": "node scripts/selling-guide-conformance-guard.cjs",
    "guard:kb": "node scripts/kb-index-guard.cjs",
    "guard:seats": "node scripts/seat-roster-guard.cjs",
    "guard:gating": "node scripts/gating-reality-guard.cjs",
    "guard:vocab": "node scripts/extract-ulad-enumerations.cjs --check && node scripts/vocabulary-registry.cjs",
    "guard:branches": "node scripts/branch-archive.cjs --check",
    "guard:staleness": "node scripts/doc-staleness-guard.cjs",
    "guard:citations": "node scripts/citation-guard.cjs",
    "guard:bundle": "node scripts/bundle-size-guard.cjs",
    "preflight": "bash scripts/preflight.sh",
    "dev:up": "bash scripts/dev-up.sh",
    "db:local": "bash scripts/local-db.sh",
    "coach:ab": "tsx scripts/coachModelAb.ts",
    "db:start": "docker start homiquity-db 2>/dev/null || docker run -d --name homiquity-db -e POSTGRES_PASSWORD=pass -e POSTGRES_DB=homiquity -p 5432:5432 postgres:16",
    "db:seed": "tsx server/scripts/runSeed.ts",
    "coach:tools": "tsx scripts/coachToolTrigger.ts",
    "benchmark:extraction": "tsx scripts/extraction-benchmark.ts",
    "benchmark:extraction:run": "tsx scripts/extraction-evaluation.ts",
    "handoff:facts": "node scripts/handoff-facts.cjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "brand:og": "node scripts/generate-og-card.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@google-cloud/storage": "^8.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "1.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "framer-motion": "^13.1.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.35.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.1",
    "passport": "^0.7.0",
    "pdfjs-dist": "6.2.108",
    "pdfkit": "^0.20.1",
    "pg": "^8.23.0",
    "plaid": "^46.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-icons": "^5.7.0",
    "react-plaid-link": "^5.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "wouter": "^3.10.0",
    "ws": "^8.21.3",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.4.0",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.13",
    "nanoid": "^6.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^11.1.1",
      "esbuild@~0.18.20": "0.25.0",
      "ip-address": "^10.3.1",
      "nanoid@<3.3.17": "3.3.17"
    }
  }
}
